{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn install && npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "yarn install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_BACKEND_HOST/api/:path*"
    }
  ]
}
